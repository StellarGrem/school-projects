import java.awt.*;
import java.awt.event.*;
import java.util.ArrayList;

class Ball{
 public static final int X=0, Y=1,LEN=2;
 private int x, y;
 private double vx, vy;
 private int framecount;
 private ArrayList<Ball>ballList = new ArrayList<Ball>();
 ArkanoidPanel apanel;
 
 public Ball(ArkanoidPanel ap){
   apanel = ap;
   ballList.add(new Ball(332,539,(double)Util.randint(4,8),(double)Util.randint(4,8)));
   ballList.get(0).framecount = 0;
 }
 
 public Ball(int xx, int yy,double vxx,double vyy){ // Constructor for multiball
   x = xx;
   y = yy;
   vx = vxx;
   vy = vyy;
   framecount = 100;
 }
 
 public void reset(){
   x = 332;
   y = 539;
   vx = (double)Util.randint(4,8);
   vy = (double)Util.randint(4,8);
   framecount = 0;
 }
 public void roundreset(){
   ballList = new ArrayList<Ball>();
   ballList.add(new Ball(332,539,(double)Util.randint(4,8),(double)Util.randint(4,8)));
   ballList.get(0).framecount = 0;
 }
 
 public Rectangle getRect(){
   return new Rectangle (x,y,10,10);
 }
 
 public void move(Platform plat, Block bl, PowerUp pwr, boolean keys[]){
   int[] pstat = plat.getStats(); // Platform X,Y,Len values
   
   if(plat.getPower().equals("multiball")){
     for(int i = 0; i < 2; i++){
       ballList.add(new Ball(ballList.get(0).x,ballList.get(0).y,ballList.get(0).vx,ballList.get(0).vy));
     }
     plat.powerup("");
   }
   
   for(Ball ba: new ArrayList<Ball>(ballList)){
     if(ba.framecount == 100 || keys[KeyEvent.VK_SPACE]){ // 100 is estimated to be roughly 3 secs
       ba.framecount = 100;
       ba.x += ba.vx;
       ba.y += ba.vy;
       Rectangle br = ba.getRect(); // Ball rectangle
       
       if(ba.y < 25){ // ceiling
         ba.vy *= -1;
         ba.y += ba.vy;
       }
       if(ba.x < 20 || ba.x > 615){ // Left Right wall
         ba.vx *= -1;
         ba.x += ba.vx;
       }
       // Powers
       if(plat.getPower().equals("slowball")){
         for(Ball b: ballList){
           if(b.vx < 0){
             b.vx = -3;
           }else{
             b.vx = 3;
           }
           if(b.vy < 0){
             b.vy = -3;
           }else{
             b.vy = 3;
           }
         }
         plat.powerup("");
       }
       
       if(br.intersects(plat.getRect())){
         if(plat.getPower().equals("sticky")){
           ba.framecount = 0;
           ba.y -= ba.vy;
         }
         // Ball bounce on platform
         if(ba.x < pstat[X]+pstat[LEN]/2 && ba.vx > 0){ // hits left of platform
           ba.vx *= ba.vx < 8 ? -1.01 : -1;
         }
         else if(ba.x > pstat[X]+pstat[LEN]/2 && ba.vx < 0){ // hits right of platform
           ba.vx *= Math.abs(ba.vx) < 8 ? -1.01 : -1;
         }
         ba.vy *= Math.abs(ba.vy) < 8 ? -1.05 : -1;
       }
       // Ball hits block
       Rectangle blr = bl.getRect(br,pwr); // Block rectangle
       if(br.intersects(blr)){
         apanel.addScore(80);
         if(!new Rectangle(ba.x,ba.y-(int)ba.vy,10,10).intersects(blr)){ // top/bottom hit
           ba.vy *= Math.abs(ba.vy) < 8 ? -1.05 : -1;
         }
         if(!new Rectangle(ba.x-(int)ba.vx,ba.y,10,10).intersects(blr)){ // side hit
           ba.vx *= Math.abs(ba.vx) < 8 ? -1.01 : -1;
         }
       }
       
       if(ba.y>610){ // below platform
         if(ballList.size() == 1){
           plat.reset();
           pwr.reset();
           ba.reset();
         }
         else{
           ballList.remove(ba);
         }
       }
     }
     else{
       if(keys[KeyEvent.VK_RIGHT]){
         ba.x += 10;
       }
       else if(keys[KeyEvent.VK_LEFT]){
         ba.x -= 10;
       }
       ba.y = 539;
       ba.framecount++;
     }
   }
   if(bl.isEmpty()){ // all blocks are gone
     roundreset();
     plat.reset();
     pwr.reset();
   }
 }
 
 public void draw(Graphics g){
  g.setColor(Color.WHITE);
   for(Ball b: ballList){
     g.fillOval(b.x,b.y,10,10);
   }
 }
}